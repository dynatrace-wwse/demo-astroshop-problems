{
  "name": "Dynatrace Enablement Container",
  // Pulling the image from the Dockerhub, runs on AMD64 and ARM64. Pulling is normally faster.
  "image":"shinojosa/dt-enablement:v1.2",
  /*
  // Building the image from the Dockerfile
  "build": {
    "image": "shinojosa/dt-enablement:v1.2"
    },
    */
  // When running locally we pass the 'secrets' as env variables via runArgs "--env-file",".devcontainer/.env"
  "runArgs": ["--init", "--privileged", "--network=host"],
  "mounts": ["source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"],
  // Entrypoint and CMD are overwritten by VSCode
  "overrideCommand": false,

  // some base images require a specific user name.
	"remoteUser": "vscode",

  "postCreateCommand": "./.devcontainer/post-create.sh",

  "postStartCommand": "./.devcontainer/post-start.sh",

  "features": {},
  "customizations": {
    "vscode": {
      // Set container specific settings
			"settings": {
				"terminal.integrated.defaultProfile.linux": "zsh"
			},
      "extensions": [ ]
    }
  },
  	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [
		80
	],
	// add labels
	"portsAttributes": {
		"80": { "label": "Application Web UI" }
	},
  // minimal CPU when running DT components and apps.
	"hostRequirements": {
		"cpus": 2
	},
  // Codespace secrets — the user is prompted for these when creating the
  // Codespace. With all 5 present the post-create auto-runs the full
  // workshop bootstrap (cluster + OneAgent + GitLab + monaco + dtctl +
  // load test + 4 release rolls). With only the first 3 the user gets
  // a clean dev container and runs `bootstrapWorkshop` manually.
  "secrets": {
    "DT_ENVIRONMENT": {
      "description": "Platform tenant URL — https://<id>.apps.dynatrace.com (sprint: https://<id>.sprint.apps.dynatracelabs.com)"
    },
    "DT_OPERATOR_TOKEN": {
      "description": "Operator token for OneAgent install. Scopes: ActiveGateTokenManagement, entities.read, settings.read, settings.write, DataExport, InstallerDownload."
    },
    "DT_INGEST_TOKEN": {
      "description": "Ingest token for OneAgent telemetry. Scopes: logs.ingest, metrics.ingest, openTelemetryTrace.ingest."
    },
    "DT_API_TOKEN": {
      "description": "Workshop API token. Scopes: events.ingest, openpipeline.events_sdlc.custom, bizevents.ingest, ReadConfig, WriteConfig, CaptureRequestData, credentialVault.read, credentialVault.write, apiTokens.read, apiTokens.write."
    },
    "DT_PLATFORM_TOKEN": {
      "description": "Platform OAuth token (dt0s16…) used by monaco + dtctl. Generate with platform scopes for documents:write, settings:read/write, workflows:run, automation:rules:read/write."
    }
  }
}
